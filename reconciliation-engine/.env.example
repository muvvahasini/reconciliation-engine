# Assessment build uses SQLite and does not require environment variables.
# Production deployment should move SECRET_KEY and database configuration here.

# Frontend API base URL (used by Vite at build time, prefix with VITE_):
VITE_API_BASE_URL=https://backend-cyan-beta-47.vercel.app/

# Backend environment variables (set these when tunneling locally for Vercel):
# SECRET_KEY=your-secret-key
# DEBUG=false
# ALLOWED_HOSTS=https://long-crews-switch.loca.lt,localhost
# CORS_ALLOW_ALL=true